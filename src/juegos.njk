---
layout: base.njk
title: Juegos
permalink: /juegos/index.html
---

<style>
  .games-section {
    padding: 50px 20px;
  }

  .games-title {
    text-align: center;
    margin-bottom: 10px;
  }

  .games-intro {
    text-align: center;
    margin: 0 auto 35px;
    max-width: 700px;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
  }

  .game-card {
    border: 1px solid #2b2b2b;
    border-radius: 12px;
    overflow: hidden;
    padding-bottom: 20px;
  }

  .game-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
  }

  .game-card-content {
    padding: 20px;
  }

  .game-button {
    display: inline-block;
    margin-top: 12px;
    padding: 10px 18px;
    background: #00d26a;
    color: #000;
    text-decoration: none;
    font-weight: bold;
    border-radius: 6px;
  }
</style>

<section class="games-section">
  <div class="container">

    <h1 class="games-title">Juegos de PARALOGIA</h1>

    <p class="games-intro">
      Explora minijuegos de misterio, terror, ciencia ficción y mundos extraños
      creados para PARALOGIA.
    </p>

    <div class="games-grid">

      {% for game in collections.all | reverse %}

        {% if game.data.game_url %}

          <article class="game-card">

            {% if game.data.image %}
              <img
                src="{{ game.data.image }}"
                alt="{{ game.data.title }}"
              >
            {% endif %}

            <div class="game-card-content">

              <h2>{{ game.data.title }}</h2>

              <p>{{ game.data.description }}</p>

              <a
                class="game-button"
                href="{{ game.data.game_url }}">
                JUGAR
              </a>

            </div>

          </article>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>
